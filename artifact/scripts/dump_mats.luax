local utils = require("common.utils")
local GameState = require("stalker2.gamestate")

local function dump_weapon_materials()
    local weapon_mesh = GameState:GetEquippedWeapon()
    if not weapon_mesh then
        print("[DEBUG-MAT] No weapon equipped.")
        return
    end

    print("[DEBUG-MAT] Dumping materials for weapon: " .. weapon_mesh:get_fname():to_string())
    
    local function dump_mesh_mats(mesh, prefix)
        if not mesh or not UEVR_UObjectHook.exists(mesh) then return end
        local num_mats = mesh:GetNumMaterials()
        print(string.format("[DEBUG-MAT] %s Mesh: %s has %d materials", prefix, mesh:get_fname():to_string(), num_mats))
        for i = 0, num_mats - 1 do
            local mat = mesh:GetMaterial(i)
            if mat then
                print(string.format("[DEBUG-MAT]   %s [%d]: %s", prefix, i, mat:GetFullName()))
            else
                print(string.format("[DEBUG-MAT]   %s [%d]: NIL", prefix, i))
            end
        end
    end

    dump_mesh_mats(weapon_mesh, "Main")

    if weapon_mesh.AttachChildren then
        local children = weapon_mesh.AttachChildren
        for i = 1, #children do
            local child = children[i]
            if child and UEVR_UObjectHook.exists(child) then
                dump_mesh_mats(child, "Child")
                if child.AttachChildren then
                    local grand_children = child.AttachChildren
                    for j = 1, #grand_children do
                        local grand_child = grand_children[j]
                        if grand_child and UEVR_UObjectHook.exists(grand_child) then
                            dump_mesh_mats(grand_child, "GrandChild")
                        end
                    end
                end
            end
        end
    end
    print("[DEBUG-MAT] Dump complete.")
end

return function()
    pcall(dump_weapon_materials)
end
